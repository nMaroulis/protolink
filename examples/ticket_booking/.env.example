# Environment configuration for vacation booking example
# Copy this file to .env and fill in your values

# ============================================
# Agent URLs (update ports if needed)
# ============================================
REGISTRY_URL=http://localhost:9010
COORDINATOR_URL=http://localhost:8010
WEATHER_AGENT_URL=http://localhost:8030
HOTEL_AGENT_URL=http://localhost:8050

# ============================================
# LLM Configuration
# ============================================
# Choose provider: "ollama" (free, local) or "openai" (API key required)
LLM_PROVIDER=openai

# Ollama settings (if using Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# OpenAI settings (if using OpenAI)
OPENAI_API_KEY=

# Alternative providers (for future use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
