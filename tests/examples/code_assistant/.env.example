# Environment configuration for Code Assistant example
# Copy this file to .env and fill in your values

# ============================================
# Agent URLs (update ports if needed)
# ============================================
REGISTRY_URL=http://localhost:9000
ORCHESTRATOR_URL=http://localhost:8010
PLANNER_AGENT_URL=http://localhost:8020
CODER_AGENT_URL=http://localhost:8030

# ============================================
# LLM Configuration
# ============================================
# Choose provider: "ollama" (free, local) or "openai" or "anthropic"
LLM_PROVIDER=openai

# Ollama settings (if using Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# OpenAI settings (if using OpenAI)
OPENAI_API_KEY=

# Alternative providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
